{
  "info": {
    "name": "SIPKITA Health",
    "description": "Pemeriksaan kesehatan API dan koneksi PostgreSQL tanpa kredensial.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "API health",
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
            "pm.test('API aktif', () => pm.expect(pm.response.json()).to.deep.equal({ status: 'ok', message: 'SIPKITA API aktif' }));"
          ]
        }
      }],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/health"
      }
    },
    {
      "name": "Database health",
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
            "pm.test('Database terhubung', () => pm.expect(pm.response.json()).to.deep.equal({ status: 'ok', database: 'connected' }));"
          ]
        }
      }],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/health/db"
      }
    }
  ],
  "variable": [{ "key": "baseUrl", "value": "http://localhost:5000" }]
}
