{
  "name": "server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "dev:supabase": "cross-env DOTENV_CONFIG_PATH=.env.supabase node --watch src/index.js",
    "start": "node src/index.js",
    "start:supabase": "cross-env DOTENV_CONFIG_PATH=.env.supabase node src/index.js",
    "test": "node --test",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:seed": "prisma db seed",
    "db:seed:tema-penelitian": "node prisma/seed-tema-penelitian.js",
    "db:rehash-dev-passwords": "node prisma/rehash-dev-passwords.js",
    "db:rehash-dev-passwords:reset": "node prisma/rehash-dev-passwords.js --reset",
    "db:rehash-dev-passwords:apply": "node prisma/rehash-dev-passwords.js --apply",
    "db:rehash-dev-passwords:reset:apply": "node prisma/rehash-dev-passwords.js --reset --apply"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
