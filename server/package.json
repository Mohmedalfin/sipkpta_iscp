    "archiver": "5.3.2",
    "argon2": "0.44.0",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.3",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "8.7.0",
    "jose": "6.2.12",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "pdfjs-dist": "4.10.38",
    "pg": "^8.13.3",
    "swagger-jsdoc": "^6.3.0"
  },
  "devDependencies": {
    "jszip": "3.10.2",
    "prisma": "7.10.1"
  }
